# =============================================================================
#  Modell-Allowlist für das KI-Bootcamp
#
#  Modell-IDs bei OpenRouter ändern sich laufend. Diese Datei ist die eine
#  Stelle, an der sie gepflegt werden — vor dem Build einmal gegen
#  https://openrouter.ai/models abgleichen.
#
#  Warum überhaupt eine Allowlist: OpenRouter bietet mehrere tausend Modelle
#  an. Ohne Einschränkung ist die Auswahl in Open WebUI unbrauchbar und die
#  Lernenden verlieren Zeit mit Scrollen statt mit Bauen.
# =============================================================================

# Stark — für Agenten, Refactoring, anspruchsvolle Aufgaben
MODELL_STARK=anthropic/claude-sonnet-5

# Schnell und günstig — Standard für Chat und Autocomplete
MODELL_SCHNELL=google/gemini-3.6-flash

# Zweite Meinung aus einem anderen Haus — für den Modellvergleich
MODELL_ALTERNATIV=openai/gpt-5-mini

# Offenes Gewichtsmodell — zeigt, wie nah Open Source herankommt
MODELL_OFFEN=qwen/qwen3-coder

# Lokal über Ollama — bewusst klein, als Kontrast gedacht
MODELL_LOKAL=qwen3:1.7b

# Für Open WebUI: dieselbe Liste, kommagetrennt
OPENWEBUI_MODEL_ALLOWLIST=anthropic/claude-sonnet-5,google/gemini-3.6-flash,openai/gpt-5-mini,qwen/qwen3-coder
